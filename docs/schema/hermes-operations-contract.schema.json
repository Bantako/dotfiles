{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morikawa.local/schema/hermes-operations-contract.schema.json",
  "title": "Hermes operations contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "freshness", "surfaces"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_age_seconds"],
      "properties": {
        "max_age_seconds": {"type": "integer", "minimum": 60, "maximum": 86400}
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/surface"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "source_of_truth",
        "unit",
        "platform",
        "expected_profile",
        "default_profile",
        "forbidden_toolsets"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "purpose": {"$ref": "#/$defs/nonEmptyString"},
        "source_of_truth": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "unit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "scope"],
          "properties": {
            "name": {"type": "string", "pattern": "^[A-Za-z0-9@_.:-]+\\.service$"},
            "scope": {"enum": ["user", "system"]}
          }
        },
        "platform": {"$ref": "#/$defs/nonEmptyString"},
        "expected_profile": {"$ref": "#/$defs/nonEmptyString"},
        "default_profile": {"$ref": "#/$defs/nonEmptyString"},
        "forbidden_toolsets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    }
  }
}
