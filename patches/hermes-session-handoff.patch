+def test_checkpoint_reader_rejects_duplicate_nonfinite_utf8_symlink_and_size(tmp_path):
+    store = CheckpointStore(tmp_path / "home")
+    path = store.write(_checkpoint())
+    valid = path.read_text(encoding="utf-8")
+    bad_payloads = [
+        valid.replace('{', '{"schema_version":1,', 1),
+        valid.replace('"schema_version":1', '"schema_version":NaN'),
+    ]
+    for index, payload in enumerate(bad_payloads):
+        bad = path.parent / f"bad-{index}.json"
+        bad.write_text(payload, encoding="utf-8")
+        with pytest.raises(CheckpointError):
+            store.read(bad)
+    invalid_utf8 = path.parent / "invalid-utf8.json"
+    invalid_utf8.write_bytes(b"\xff")
+    with pytest.raises(CheckpointError):
+        store.read(invalid_utf8)
+    oversized = path.parent / "oversized.json"
+    oversized.write_bytes(b"x" * (128 * 1024 + 1))
+    with pytest.raises(CheckpointError):
+        store.read(oversized)
+    symlink = path.parent / "linked.json"
+    symlink.symlink_to(path)
+    with pytest.raises(CheckpointError):
+        store.read(symlink)
