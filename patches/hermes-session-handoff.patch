+"""Manual fresh-session handoff primitives.
+
+Phase 1 deliberately exposes these only through the local TUI commands.  It
+contains no automatic compression trigger.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import copy
+from datetime import datetime, timezone
+import json
+import math
+import os
+from pathlib import Path
+import re
+import secrets
+import subprocess
+import time
+from typing import Any, Callable, Mapping
+
+from agent.redact import redact_sensitive_text
+from hermes_constants import get_hermes_home
+
+SCHEMA_VERSION = 1
+MAX_CHECKPOINT_BYTES = 128 * 1024
+_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")
+_REQUIRED_FIELDS = frozenset({
+    "schema_version", "checkpoint_id", "created_at", "source_profile",
+    "source_session_id", "logical_lineage_id", "cwd", "git",
+    "task_objective", "constraints", "decisions", "rejected_alternatives",
+    "verified_state", "changed_artifacts", "verification_evidence",
+    "unresolved_items", "next_action", "human_gates", "stop_conditions",
+    "todo", "goal", "running_work",
+})
+
+
+class CheckpointError(ValueError):
+    """Checkpoint validation or persistence failed safely."""
+
+
+def validate_handoff_id(value: Any, field: str = "handoff ID") -> str:
+    """Validate an identifier before any path construction or DB transition."""
+    if not isinstance(value, str) or not _ID_RE.fullmatch(value):
+        raise CheckpointError(f"unsafe {field}")
+    return value
+
+
+def _reject_constant(value: str) -> None:
+    raise CheckpointError(f"non-finite JSON number: {value}")
+
+
+def _pairs_no_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in result:
+            raise CheckpointError(f"duplicate JSON key: {key}")
+        result[key] = value
+    return result
+
+
+def _redact(value: Any) -> Any:
+    if isinstance(value, str):
+        return redact_sensitive_text(value, force=True, redact_url_credentials=True)
+    if isinstance(value, list):
+        return [_redact(item) for item in value]
+    if isinstance(value, dict):
+        return {str(key): _redact(item) for key, item in value.items()}
+    return value
+
+
+def _validate_tree(value: Any, *, depth: int = 0) -> None:
+    if depth > 16:
+        raise CheckpointError("checkpoint nesting is too deep")
+    if value is None or isinstance(value, (str, bool, int)):
+        return
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise CheckpointError("non-finite number")
+        return
+    if isinstance(value, list):
+        if len(value) > 512:
+            raise CheckpointError("checkpoint list is too large")
+        for item in value:
+            _validate_tree(item, depth=depth + 1)
+        return
+    if isinstance(value, dict):
+        if len(value) > 256 or not all(isinstance(k, str) for k in value):
+            raise CheckpointError("invalid checkpoint object")
+        for item in value.values():
+            _validate_tree(item, depth=depth + 1)
+        return
+    raise CheckpointError(f"unsupported checkpoint value: {type(value).__name__}")
+
+
+def _validate_text_list(data: Mapping[str, Any], key: str, *, limit: int = 256) -> None:
+    value = data.get(key)
+    if not isinstance(value, list) or len(value) > limit:
+        raise CheckpointError(f"{key} must be a bounded list")
+    if any(not isinstance(item, str) or len(item) > 4096 for item in value):
+        raise CheckpointError(f"{key} entries must be bounded text")
+
+
+def _validate_schema(plain: Mapping[str, Any]) -> None:
+    git = plain.get("git")
+    if not isinstance(git, dict) or set(git) != {"repo_root", "branch", "changed_paths"}:
+        raise CheckpointError("git must use the canonical schema")
+    for key in ("repo_root", "branch"):
+        if git[key] is not None and not isinstance(git[key], str):
+            raise CheckpointError(f"git.{key} must be nullable text")
+    changed_paths = git["changed_paths"]
+    if not isinstance(changed_paths, list) or len(changed_paths) > 256 or any(
+        not isinstance(path, str) or len(path) > 1024 for path in changed_paths
+    ):
+        raise CheckpointError("git.changed_paths must be bounded text")
+    for key in (
+        "constraints", "decisions", "rejected_alternatives", "verified_state",
+        "changed_artifacts", "unresolved_items",
+        "human_gates", "stop_conditions",
+    ):
+        _validate_text_list(plain, key)
+    verification = plain.get("verification_evidence")
+    if not isinstance(verification, list) or len(verification) > 256:
+        raise CheckpointError("verification_evidence must be a bounded list")
+    for item in verification:
+        if not isinstance(item, dict) or set(item) != {"command", "exit_status", "timestamp"}:
+            raise CheckpointError("verification evidence entry has invalid schema")
+        if not isinstance(item["command"], str) or not isinstance(item["timestamp"], str):
+            raise CheckpointError("verification evidence text fields are invalid")
+        if isinstance(item["exit_status"], bool) or not isinstance(item["exit_status"], int):
+            raise CheckpointError("verification evidence exit_status is invalid")
+    todo = plain.get("todo")
+    if not isinstance(todo, list) or len(todo) > 128:
+        raise CheckpointError("todo must be a bounded list")
+    for item in todo:
+        if not isinstance(item, dict) or set(item) != {"id", "content", "status"}:
+            raise CheckpointError("todo entry must use the canonical schema")
+        if any(not isinstance(item[key], str) for key in ("id", "content", "status")):
+            raise CheckpointError("todo entry values must be text")
+        if item["status"] not in {"pending", "in_progress"}:
+            raise CheckpointError("todo status is invalid")
+        if len(item["id"]) > 128 or len(item["content"]) > 2000 or len(item["status"]) > 32:
+            raise CheckpointError("todo entry exceeds bounds")
+    goal = plain.get("goal")
+    if goal is not None and not isinstance(goal, (dict, str)):
+        raise CheckpointError("goal must be null, text, or an object")
+    running = plain.get("running_work")
+    if not isinstance(running, list) or len(running) > 128:
+        raise CheckpointError("running_work must be a bounded list")
+    allowed_work = {"session_id", "delegation_id", "pid", "status", "state",
+                    "task_id", "session_key", "parent_session_id", "origin_ui_session_id"}
+    for item in running:
+        if not isinstance(item, dict) or not set(item) <= allowed_work or not item:
+            raise CheckpointError("running_work entry must use the canonical schema")
+        if any(not isinstance(value, (str, int, bool, type(None))) or isinstance(value, float)
+               for value in item.values()):
+            raise CheckpointError("running_work entry has invalid values")
+
+
+@dataclass(frozen=True)
+class SessionHandoffCheckpoint:
+    _data: Mapping[str, Any]
+
+    @classmethod
+    def from_dict(cls, data: Mapping[str, Any]) -> "SessionHandoffCheckpoint":
+        if not isinstance(data, Mapping):
+            raise CheckpointError("checkpoint must be an object")
+        plain = copy.deepcopy(dict(data))
+        missing = _REQUIRED_FIELDS - plain.keys()
+        unknown = plain.keys() - _REQUIRED_FIELDS
+        if missing or unknown:
+            raise CheckpointError(
+                f"checkpoint fields mismatch; missing={sorted(missing)}, unknown={sorted(unknown)}"
+            )
+        if plain["schema_version"] != SCHEMA_VERSION:
+            raise CheckpointError("unsupported checkpoint schema")
+        for key in ("checkpoint_id", "logical_lineage_id"):
+            validate_handoff_id(plain.get(key), key)
+        for key in ("created_at", "source_profile", "source_session_id", "cwd", "task_objective", "next_action"):
+            if not isinstance(plain.get(key), str):
+                raise CheckpointError(f"{key} must be text")
+        _validate_schema(plain)
+        _validate_tree(plain)
+        encoded = json.dumps(plain, ensure_ascii=False, allow_nan=False, separators=(",", ":")).encode("utf-8", "strict")
+        if len(encoded) > MAX_CHECKPOINT_BYTES:
+            raise CheckpointError("checkpoint exceeds size limit")
+        return cls(plain)
+
+    @property
+    def checkpoint_id(self) -> str:
+        return str(self._data["checkpoint_id"])
+
+    @property
+    def logical_lineage_id(self) -> str:
+        return str(self._data["logical_lineage_id"])
+
+    def to_dict(self) -> dict[str, Any]:
+        return copy.deepcopy(dict(self._data))
+
+
+def _git(cwd: Path, *args: str) -> str | None:
+    try:
+        result = subprocess.run(
+            ["git", "-C", str(cwd), *args],
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL,
+            text=True,
+            encoding="utf-8",
+            errors="strict",
+            timeout=2.0,
+            check=False,
+        )
+    except (OSError, subprocess.SubprocessError, UnicodeError):
+        return None
+    if result.returncode != 0:
+        return None
+    return result.stdout[:16_384]
+
+
+def collect_evidence(
+    cwd: Path | str,
+    *,
+    todo: list[Mapping[str, Any]] | None = None,
+    goal: Mapping[str, Any] | None = None,
+    running_work: list[Mapping[str, Any]] | None = None,
+    source_session_id: str | None = None,
+) -> dict[str, Any]:
+    """Collect bounded references to live state, never file/diff contents."""
+    cwd_path = Path(cwd).resolve(strict=False)
+    root = _git(cwd_path, "rev-parse", "--show-toplevel")
+    branch = _git(cwd_path, "branch", "--show-current")
+    status = _git(cwd_path, "status", "--short", "--untracked-files=all")
+    changed_paths: list[str] = []
+    if status is not None:
+        for line in status.splitlines()[:256]:
+            path = line[3:] if len(line) > 3 else ""
+            if " -> " in path:
+                path = path.split(" -> ", 1)[1]
+            path = path.strip().strip('"')
+            if path and path not in changed_paths:
+                changed_paths.append(path[:1024])
+    active_todo = []
+    for item in (todo or [])[:128]:
+        if not isinstance(item, Mapping):
+            continue
+        status_value = str(item.get("status") or "pending")[:32]
+        if status_value not in {"pending", "in_progress"}:
+            continue
+        active_todo.append({
+            "id": str(item.get("id") or "?")[:128],
+            "content": str(item.get("content") or "")[:2000],
+            "status": status_value,
+        })
+    goal_ref = None
+    if isinstance(goal, Mapping):
+        goal_ref = copy.deepcopy(dict(goal))
+    work_refs = []
+    candidate_work = (
+        filter_owned_running_work(running_work or [], source_session_id)
+        if source_session_id else list(running_work or [])[:128]
+    )
+    for item in candidate_work:
+        if not isinstance(item, Mapping):
+            continue
+        ref = {
+            key: item[key]
+            for key in ("session_id", "delegation_id", "pid", "status", "state",
+                        "task_id", "session_key", "parent_session_id", "origin_ui_session_id")
+            if key in item and isinstance(item[key], (str, int, bool, type(None)))
+        }
+        if ref:
+            work_refs.append(ref)
+    verification_evidence = []
+    if source_session_id:
+        try:
+            from agent.verification_evidence import list_verification_evidence
+            verification_evidence = list_verification_evidence(
+                session_id=source_session_id, cwd=cwd_path, limit=64)
+        except Exception:
+            verification_evidence = []
+    evidence = {
+        "cwd": str(cwd_path)[:4096],
+        "git": {
+            "repo_root": (root or "").strip()[:4096] or None,
+            "branch": (branch or "").strip()[:512] or None,
+            "changed_paths": sorted(changed_paths),
+        },
+        "todo": active_todo,
+        "goal": goal_ref,
+        "running_work": work_refs,
+        "verification_evidence": verification_evidence,
+    }
+    return _redact(evidence)
+
+
+def filter_owned_running_work(entries, source_session_id: str | None) -> list[dict[str, Any]]:
+    """Require positive source ownership before applying the 128-entry bound."""
+    if not source_session_id:
+        return []
+    fields = ("task_id", "session_key", "parent_session_id", "origin_ui_session_id")
+    owned = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            continue
+        if item.get("status") != "running":
+            continue
+        if not any(str(item.get(key) or "") == source_session_id for key in fields):
+            continue
+        owned.append(dict(item))
+        if len(owned) >= 128:
+            break
+    return owned
+
+
+def latest_real_user_intent(messages: list[Mapping[str, Any]]) -> str:
+    """Return the latest real user text, excluding synthetic carry-over rows."""
+    for message in reversed(messages):
+        if message.get("role") != "user":
+            continue
+        if any(
+            bool(value) and ("synthetic" in str(key) or "compression" in str(key))
+            for key, value in message.items()
+            if str(key).startswith("_")
+        ):
+            continue
+        content = message.get("content")
+        if not isinstance(content, str) or not content.strip():
+            continue
+        try:
+            continuation = json.loads(content)
+        except (TypeError, ValueError, json.JSONDecodeError):
+            continuation = None
+        if (
+            isinstance(continuation, dict)
+            and continuation.get("instruction")
+            == "Read and verify the checkpoint and live artifacts before continuing."
+            and isinstance(continuation.get("handoff_checkpoint"), str)
+            and isinstance(continuation.get("checkpoint_id"), str)
+        ):
+            continue
+        synthetic_prefixes = (
+            "[Your active task list was preserved across context compression]",
+            "[Continuing toward your standing goal]",
+            "[KANBAN CONTINUATION]",
+            "[Kanban synthetic continuation]",
+            "Continue from the compressed conversation context above. This marker exists because",
+        )
+        if content.startswith(synthetic_prefixes):
+            continue
+        return content.strip()[:8000]
+    return "Continue from the verified checkpoint."
+
+
+_SUMMARY_SECTION_MAP = {
+    "Constraints & Preferences": "constraints",
+    "Key Decisions": "decisions",
+    "Completed Actions": "verified_state",
+    "Active State": "verified_state",
+    "Blocked": "unresolved_items",
+    "Historical Pending User Asks": "unresolved_items",
+    "Pending User Asks": "unresolved_items",
+    "Historical Remaining Work": "unresolved_items",
+    "Remaining Work": "unresolved_items",
+    "Resolved Questions": "rejected_alternatives",
+}
+
+
+def _summary_semantics(messages: list[Mapping[str, Any]]) -> dict[str, list[str]]:
+    """Extract only bounded known sections from the latest Hermes summary."""
+    result = {key: [] for key in (
+        "goal",
+        "constraints", "decisions", "rejected_alternatives", "verified_state",
+        "verification_evidence", "unresolved_items", "human_gates", "stop_conditions",
+    )}
+    summary = None
+    for message in reversed(messages):
+        content = message.get("content")
+        if message.get("role") == "assistant" and isinstance(content, str) and (
+            message.get("_compressed_summary") or message.get("_compression_summary")
+            or content.startswith("[CONTEXT COMPACTION — REFERENCE ONLY]")
+            or content.startswith("[CONTEXT SUMMARY]:")
+            or "[END OF PRIOR CONTEXT — COMPACTION SUMMARY BELOW]" in content[:4096]
+        ):
+            summary = content[:32_768]
+            break
+    if summary is None:
+        return result
+    sections: dict[str, list[str]] = {}
+    current = ""
+    for raw_line in summary.splitlines()[:512]:
+        heading = re.match(r"^##\s+(.+?)\s*$", raw_line)
+        if heading:
+            current = heading.group(1)
+            sections.setdefault(current, [])
+            continue
+        if current and raw_line.strip() and not raw_line.startswith("--- END OF CONTEXT SUMMARY"):
+            item = re.sub(r"^(?:[-*]|\d+[.)])\s*", "", raw_line.strip())[:2000]
+            if item and item.lower() not in {"none", "none."}:
+                sections[current].append(item)
+    for heading, target in _SUMMARY_SECTION_MAP.items():
+        result[target].extend(sections.get(heading, [])[:64])
+    result["goal"] = sections.get("Goal", [])[:8]
+    critical = sections.get("Critical Context", [])[:64]
+    result["human_gates"] = [item for item in critical if re.search(
+        r"\b(human|confirmation|approval|approve|manual gate)\b", item, re.I
+    )]
+    result["stop_conditions"] = [item for item in critical if re.search(
+        r"\b(stop|abort|fail(?:ed)? closed|must not|do not)\b", item, re.I
+    )]
+    return _redact(result)
+
+
+def create_checkpoint(
+    *,
+    source_profile: str,
+    source_session_id: str,
+    logical_lineage_id: str,
+    messages: list[Mapping[str, Any]],
+    evidence: Mapping[str, Any],
+    checkpoint_id: str | None = None,
+    created_at: str | None = None,
+) -> SessionHandoffCheckpoint:
+    """Build the complete bounded Phase-1 schema from deterministic live state."""
+    intent = latest_real_user_intent(messages)
+    semantics = _summary_semantics(messages)
+    git = evidence.get("git") if isinstance(evidence.get("git"), Mapping) else {}
+    changed = list(git.get("changed_paths") or [])[:256]
+    summary_goal = " ".join(semantics["goal"]).strip()[:8000]
+    vague = intent == "Continue from the verified checkpoint." or bool(re.fullmatch(
+        r"\s*(?:continue|continue\.|keep going|go on|続けて|続行|そのまま続けて)\s*",
+        intent, re.I))
+    data = {
+        "schema_version": SCHEMA_VERSION,
+        "checkpoint_id": checkpoint_id or f"cp-{int(time.time())}-{secrets.token_hex(6)}",
+        "created_at": created_at or datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
+        "source_profile": source_profile,
+        "source_session_id": source_session_id,
+        "logical_lineage_id": logical_lineage_id,
+        "cwd": str(evidence.get("cwd") or ""),
+        "git": dict(git),
+        "task_objective": summary_goal if summary_goal and vague else intent,
+        "constraints": semantics["constraints"],
+        "decisions": semantics["decisions"],
+        "rejected_alternatives": semantics["rejected_alternatives"],
+        "verified_state": semantics["verified_state"],
+        "changed_artifacts": changed,
+        "verification_evidence": list(evidence.get("verification_evidence") or [])[:64],
+        "unresolved_items": semantics["unresolved_items"],
+        "next_action": "Read the checkpoint and re-verify live artifacts before continuing.",
+        "human_gates": semantics["human_gates"],
+        "stop_conditions": semantics["stop_conditions"],
+        "todo": list(evidence.get("todo") or []),
+        "goal": evidence.get("goal"),
+        "running_work": list(evidence.get("running_work") or []),
+    }
+    return SessionHandoffCheckpoint.from_dict(_redact(data))
+
+
+def build_continuation_messages(
+    checkpoint: SessionHandoffCheckpoint,
+    checkpoint_path: Path,
+    latest_user_intent: str,
+) -> list[dict[str, str]]:
+    """Build one fresh user turn without old summary/tail/tool transcript."""
+    data = checkpoint.to_dict()
+    intent = (latest_user_intent or "Continue from the verified checkpoint.")[:8000]
+    payload = {
+        "handoff_checkpoint": str(checkpoint_path),
+        "checkpoint_id": checkpoint.checkpoint_id,
+        "objective": data["task_objective"],
+        "next_action": data["next_action"],
+        "latest_user_intent": intent,
+        "todo": data["todo"],
+        "goal": data["goal"],
+        "instruction": "Read and verify the checkpoint and live artifacts before continuing.",
+    }
+    content = json.dumps(_redact(payload), ensure_ascii=False, allow_nan=False, sort_keys=True)
+    if len(content.encode("utf-8")) > 32_768:
+        raise CheckpointError("continuation payload exceeds size limit")
+    return [{"role": "user", "content": content}]
+
+
+@dataclass(frozen=True)
+class HandoffResult:
+    source_session_id: str
+    destination_session_id: str
+    checkpoint_path: Path
+    messages: list[dict[str, str]]
+
+
+def transactional_handoff(
+    *,
+    db: Any,
+    checkpoint: SessionHandoffCheckpoint,
+    source_messages: list[Mapping[str, Any]],
+    latest_user_intent: str,
+    fresh_system_prompt: str,
+    destination_session_id: str,
+    migrate_state: Callable[[str, str, list[Any], Any], None],
+    rollback_state: Callable[[str, str], None],
+    switch_context: Callable[[str, list[dict[str, str]]], None],
+    rollback_context: Callable[[str], None],
+    store: "CheckpointStore | None" = None,
+) -> HandoffResult:
+    """Commit a manual handoff or restore the source session on any failure."""
+    del source_messages  # Explicitly forbidden from entering fresh context.
+    data = checkpoint.to_dict()
+    source_id = str(data["source_session_id"])
+    if not source_id or not destination_session_id or source_id == destination_session_id:
+        raise CheckpointError("invalid handoff session IDs")
+    source = db.get_session(source_id)
+    if source is None or source.get("ended_at") is not None:
+        raise CheckpointError("source session is not live")
+    holder = f"handoff:{os.getpid()}:{secrets.token_hex(8)}"
+    if not db.try_acquire_compression_lock(source_id, holder, ttl_seconds=120.0):
+        raise CheckpointError("handoff already in progress")
+    checkpoint_path: Path | None = None
+    destination_created = False
+    migration_attempted = False
+    switch_attempted = False
+    stage = "checkpoint_write"
+    try:
+        checkpoint_store = store or CheckpointStore()
+        checkpoint_path = checkpoint_store.write(checkpoint)
+        stage = "checkpoint_readback"
+        # A second strict read-back occurs immediately before changing DB state.
+        verified = checkpoint_store.read(checkpoint_path)
+        if verified.to_dict() != checkpoint.to_dict():
+            raise CheckpointError("checkpoint verification failed")
+        messages = build_continuation_messages(verified, checkpoint_path, latest_user_intent)
+        stage = "database"
+        raw_source_config = source.get("model_config")
+        try:
+            metadata = (
+                json.loads(raw_source_config)
+                if isinstance(raw_source_config, str)
+                else copy.deepcopy(raw_source_config or {})
+            )
+        except (TypeError, ValueError, json.JSONDecodeError):
+            metadata = {}
+        if not isinstance(metadata, dict):
+            metadata = {}
+        metadata["_handoff"] = {
+            "source_session_id": source_id,
+            "checkpoint_id": checkpoint.checkpoint_id,
+            "logical_lineage_id": checkpoint.logical_lineage_id,
+        }
+        destination_goal = db.get_meta(f"goal:{source_id}")
+        db.handoff_session_transaction(
+            source_session_id=source_id, destination_session_id=destination_session_id,
+            source="cli",
+            model=source.get("model"),
+            model_config=metadata,
+            system_prompt=fresh_system_prompt,
+            parent_session_id=source_id,
+            cwd=data["cwd"],
+            profile_name=data["source_profile"],
+            git_repo_root=(data.get("git") or {}).get("repo_root"),
+            messages=messages, handoff_meta=metadata["_handoff"],
+            destination_goal=destination_goal,
+        )
+        destination_created = True
+        stage = "state_migration"
+        migration_attempted = True
+        migrate_state(source_id, destination_session_id, data["todo"], data["goal"])
+        stage = "context_switch"
+        switch_attempted = True
+        switch_context(destination_session_id, messages)
+        return HandoffResult(source_id, destination_session_id, checkpoint_path, messages)
+    except Exception as exc:
+        rollback_errors: list[Exception] = []
+        if switch_attempted:
+            try:
+                rollback_context(source_id)
+            except Exception as rollback_exc:
+                rollback_errors.append(rollback_exc)
+        if migration_attempted:
+            try:
+                rollback_state(source_id, destination_session_id)
+            except Exception as rollback_exc:
+                rollback_errors.append(rollback_exc)
+        try:
+            if destination_created:
+                db.rollback_handoff_transaction(
+                    source_session_id=source_id,
+                    destination_session_id=destination_session_id,
+                    checkpoint_id=checkpoint.checkpoint_id,
+                )
+        except Exception as rollback_exc:
+            rollback_errors.append(rollback_exc)
+        if rollback_errors:
+            failures = ", ".join(type(error).__name__ for error in rollback_errors)
+            raise CheckpointError(
+                f"stage={stage}; checkpoint={checkpoint_path or 'none'}; "
+                f"failure={type(exc).__name__}; rollback failed ({failures})"
+            ) from exc
+        raise CheckpointError(
+            f"stage={stage}; checkpoint={checkpoint_path or 'none'}; "
+            f"failure={type(exc).__name__}; rollback=ok"
+        ) from exc
+    finally:
+        db.release_compression_lock(source_id, holder)
+
