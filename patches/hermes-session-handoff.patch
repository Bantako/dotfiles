+    def get_compression_count(self, session_id: str) -> int:
+        """Count canonical compression continuations ending at *session_id*.
+
+        A continuation must start after its compression parent was durably
+        ended and must not carry the stable branch marker.  Delegate children
+        are launched while the parent is live, so they are excluded too.
+        Unknown rows and malformed/cyclic lineages fail closed to zero.
+        """
+        if not session_id:
+            return 0
+        with self._lock:
+            rows = self._conn.execute(
+                """
+                WITH RECURSIVE chain(id, parent_session_id, depth, seen) AS (
+                    SELECT id, parent_session_id, 0, ',' || id || ','
+                    FROM sessions WHERE id = ?
+                    UNION ALL
+                    SELECT parent.id, parent.parent_session_id, chain.depth + 1,
+                           chain.seen || parent.id || ','
+                    FROM chain
+                    JOIN sessions child ON child.id = chain.id
+                    JOIN sessions parent ON parent.id = child.parent_session_id
+                    WHERE parent.end_reason = 'compression'
+                      AND parent.ended_at IS NOT NULL
+                      AND child.started_at >= parent.ended_at
+                      AND (child.model_config IS NULL OR json_valid(child.model_config))
+                      AND json_extract(COALESCE(child.model_config, '{}'),
+                                       '$._branched_from') IS NULL
+                      AND json_extract(COALESCE(child.model_config, '{}'),
+                                       '$._delegate_from') IS NULL
+                      AND instr(chain.seen, ',' || parent.id || ',') = 0
+                      AND chain.depth < 256
+                )
+                SELECT depth, parent_session_id, seen FROM chain
+                ORDER BY depth DESC LIMIT 1
+                """,
+                (session_id,),
+            ).fetchone()
+            exists = self._conn.execute(
+                "SELECT 1 FROM sessions WHERE id = ?", (session_id,)
+            ).fetchone()
+            cycle = self._conn.execute(
+                """WITH RECURSIVE walk(id, parent_id, seen, cycle, depth) AS (
+                     SELECT id, parent_session_id, ',' || id || ',', 0, 0
+                     FROM sessions WHERE id = ?
+                     UNION ALL
+                     SELECT p.id, p.parent_session_id, walk.seen || p.id || ',',
+                            instr(walk.seen, ',' || p.id || ',') > 0, walk.depth + 1
+                     FROM walk JOIN sessions p ON p.id = walk.parent_id
+                     WHERE walk.cycle = 0 AND walk.depth < 256
+                   ) SELECT MAX(cycle) AS cycle FROM walk""",
+                (session_id,),
+            ).fetchone()
+        if not exists or not rows or (cycle and cycle["cycle"]):
+            return 0
+        return int(rows["depth"])
