+def test_concurrent_handoffs_allow_only_one_live_destination(tmp_path):
+    path = tmp_path / "state.db"
+    setup = SessionDB(db_path=path)
+    _session(setup, "source")
+    barrier = threading.Barrier(2)
+    outcomes = []
+
+    def contender(destination):
+        db = SessionDB(db_path=path)
+        barrier.wait()
+        try:
+            db.handoff_session_transaction(
+                source_session_id="source", destination_session_id=destination,
+                source="cli", model=None, model_config={}, system_prompt="fresh",
+                parent_session_id="source", cwd=None, profile_name="default",
+                git_repo_root=None, messages=[{"role": "user", "content": "continue"}],
+                handoff_meta={"checkpoint_id": destination}, destination_goal=None,
+            )
+            outcomes.append((destination, "ok"))
+        except ValueError as exc:
+            outcomes.append((destination, str(exc)))
+
+    threads = [threading.Thread(target=contender, args=(f"destination-{n}",)) for n in (1, 2)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join()
+
+    assert sum(result == "ok" for _, result in outcomes) == 1
+    assert sum("source session is not live" in result for _, result in outcomes) == 1
+    live_destinations = [
+        sid for sid in ("destination-1", "destination-2")
+        if setup.get_session(sid) is not None
+    ]
+    assert len(live_destinations) == 1
