+class CheckpointStore:
+    def __init__(self, home: Path | None = None):
+        self.home = Path(home) if home is not None else get_hermes_home()
+
+    def _directory(self, lineage_id: str) -> Path:
+        validate_handoff_id(lineage_id, "logical_lineage_id")
+        base = self.home / "handoffs"
+        target = base / lineage_id
+        for path in (self.home, base, target):
+            if path.exists() and path.is_symlink():
+                raise CheckpointError(f"symlink is not allowed: {path}")
+        target.mkdir(mode=0o700, parents=True, exist_ok=True)
+        os.chmod(base, 0o700)
+        os.chmod(target, 0o700)
+        return target
+
+    def write(self, checkpoint: SessionHandoffCheckpoint) -> Path:
+        safe = SessionHandoffCheckpoint.from_dict(_redact(checkpoint.to_dict()))
+        directory = self._directory(safe.logical_lineage_id)
+        destination = directory / f"{safe.checkpoint_id}.json"
+        if destination.is_symlink():
+            raise CheckpointError("checkpoint destination is a symlink")
+        payload = json.dumps(
+            safe.to_dict(), ensure_ascii=False, allow_nan=False,
+            sort_keys=True, separators=(",", ":"),
+        ).encode("utf-8", "strict")
+        if len(payload) > MAX_CHECKPOINT_BYTES:
+            raise CheckpointError("checkpoint exceeds size limit")
+        if destination.exists():
+            if destination.read_bytes() == payload:
+                loaded = self.read(destination)
+                if loaded.to_dict() != safe.to_dict():
+                    raise CheckpointError("checkpoint read-back payload mismatch")
+                return destination
+            raise CheckpointError("checkpoint ID collision")
+        temporary = directory / f".{safe.checkpoint_id}.{secrets.token_hex(8)}.tmp"
+        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
+        if hasattr(os, "O_NOFOLLOW"):
+            flags |= os.O_NOFOLLOW
+        fd = -1
+        try:
+            fd = os.open(temporary, flags, 0o600)
+            with os.fdopen(fd, "wb", closefd=True) as stream:
+                fd = -1
+                stream.write(payload)
+                stream.flush()
+                os.fsync(stream.fileno())
+            try:
+                os.link(temporary, destination, follow_symlinks=False)
+            except FileExistsError:
+                if destination.read_bytes() == payload:
+                    loaded = self.read(destination)
+                    if loaded.to_dict() == safe.to_dict():
+                        return destination
+                raise CheckpointError("checkpoint ID collision")
+            temporary.unlink()
+            os.chmod(destination, 0o600)
+            dir_fd = os.open(directory, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
+            try:
+                os.fsync(dir_fd)
+            finally:
+                os.close(dir_fd)
+            loaded = self.read(destination)
+            if loaded.to_dict() != safe.to_dict():
+                raise CheckpointError("checkpoint read-back payload mismatch")
+            return destination
+        except (OSError, UnicodeError, json.JSONDecodeError) as exc:
+            raise CheckpointError(f"checkpoint write failed: {type(exc).__name__}") from exc
+        finally:
+            if fd >= 0:
+                os.close(fd)
+            try:
+                temporary.unlink(missing_ok=True)
+            except OSError:
+                pass
+
+    def read(self, path: Path) -> SessionHandoffCheckpoint:
+        path = Path(path)
+        try:
+            home = self.home.resolve(strict=False)
+            resolved = path.resolve(strict=False)
+            if home != resolved and home not in resolved.parents:
+                raise CheckpointError("checkpoint path escapes HERMES_HOME")
+            if path.is_symlink() or not path.is_file():
+                raise CheckpointError("checkpoint is not a regular file")
+            raw = path.read_bytes()
+            if len(raw) > MAX_CHECKPOINT_BYTES:
+                raise CheckpointError("checkpoint exceeds size limit")
+            text = raw.decode("utf-8", "strict")
+            data = json.loads(
+                text,
+                object_pairs_hook=_pairs_no_duplicates,
+                parse_constant=_reject_constant,
+            )
+            return SessionHandoffCheckpoint.from_dict(data)
+        except CheckpointError:
+            raise
+        except (OSError, UnicodeError, json.JSONDecodeError) as exc:
+            raise CheckpointError(f"checkpoint read failed: {type(exc).__name__}") from exc
