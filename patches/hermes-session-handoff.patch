+        handoff_meta: Dict[str, Any],
+        destination_goal: Optional[str],
+    ) -> None:
+        """Atomically end a live source and create its handoff destination.
+
+        The authoritative source read, destination collision check, source CAS,
+        destination insert, continuation rows, and handoff/goal metadata all run
+        under one ``BEGIN IMMEDIATE`` transaction. Filesystem checkpoints and
+        subsequent in-memory/UI switching are deliberately outside this SQLite
+        atomicity boundary.
+        """
+        config = dict(model_config or {})
+        config["_handoff"] = dict(handoff_meta)
+        parsed_destination_goal: Optional[Dict[str, Any]] = None
+        if destination_goal is not None:
+            try:
+                parsed_destination_goal = json.loads(destination_goal)
+            except (TypeError, ValueError, json.JSONDecodeError) as exc:
+                raise ValueError("source goal metadata is invalid") from exc
+            if not isinstance(parsed_destination_goal, dict):
+                raise ValueError("source goal metadata is invalid")
+
+        def _do(conn):
+            source_row = conn.execute(
+                "SELECT ended_at FROM sessions WHERE id = ?", (source_session_id,)
+            ).fetchone()
+            if source_row is None or source_row["ended_at"] is not None:
+                raise ValueError("source session is not live")
+            if conn.execute(
+                "SELECT 1 FROM sessions WHERE id = ?", (destination_session_id,)
+            ).fetchone() is not None:
+                raise ValueError("destination session already exists")
+            if conn.execute(
+                "SELECT 1 FROM state_meta WHERE key = ?",
+                (f"goal:{destination_session_id}",),
+            ).fetchone() is not None:
+                raise ValueError("destination goal already exists")
+            ended = conn.execute(
+                "UPDATE sessions SET ended_at = ?, end_reason = 'handoff' "
+                "WHERE id = ? AND ended_at IS NULL",
+                (time.time(), source_session_id),
+            )
+            if ended.rowcount != 1:
+                raise ValueError("source session is not live")
+            conn.execute(
+                """INSERT INTO sessions (
+                   id, source, model, model_config, system_prompt,
+                   parent_session_id, cwd, profile_name, git_repo_root, started_at
+                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
+                (
+                    destination_session_id, source, model,
+                    json.dumps(config) if config else None, system_prompt,
+                    parent_session_id, cwd, profile_name, git_repo_root, time.time(),
+                ),
+            )
+            inserted, tool_calls = self._insert_message_rows(
+                conn, destination_session_id, messages
+            )
+            conn.execute(
+                "UPDATE sessions SET message_count = ?, tool_call_count = ? WHERE id = ?",
+                (inserted, tool_calls, destination_session_id),
+            )
+            if destination_goal is not None:
+                assert parsed_destination_goal is not None
+                conn.execute(
+                    "INSERT INTO state_meta (key, value) VALUES (?, ?)",
+                    (f"goal:{destination_session_id}", destination_goal),
+                )
+                cleared = dict(parsed_destination_goal)
+                cleared["status"] = "cleared"
+                conn.execute(
+                    "INSERT INTO state_meta (key, value) VALUES (?, ?) "
+                    "ON CONFLICT(key) DO UPDATE SET value = excluded.value",
+                    (f"goal:{source_session_id}", json.dumps(cleared, ensure_ascii=False)),
+                )
+
+        self._execute_write(_do)
