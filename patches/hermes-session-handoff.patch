+def test_failed_source_rebind_still_restores_local_source_identity_and_state(tmp_path, monkeypatch, capsys):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "home"))
+    monkeypatch.setenv("TERMINAL_CWD", str(tmp_path))
+    monkeypatch.setattr("hermes_cli.profiles.get_active_profile_name", lambda: "default")
+    log_ids = []
+    process_ids = []
+    monkeypatch.setattr("hermes_logging.set_session_context", log_ids.append)
+    monkeypatch.setattr("cli._sync_process_session_id", process_ids.append)
+    obj = _cli(tmp_path)
+    source_history = list(obj.conversation_history)
+    source_todo = obj.agent._todo_store
+    source_prompt = obj.agent._cached_system_prompt
+    engine = type("Engine", (), {})()
+    engine.compression_count = 1
+    engine.last_prompt_tokens = 777
+    engine.last_completion_tokens = 99
+    engine.last_total_tokens = 876
+    engine._session_id = "source-1"
+    obj.agent.context_compressor = engine
+    engine_state = dict(engine.__dict__)
+    source_runtime = {
+        name: getattr(obj.agent, name) for name in (
+            "session_total_tokens", "session_input_tokens", "session_output_tokens",
+            "session_prompt_tokens", "session_completion_tokens", "session_cache_read_tokens",
+            "session_cache_write_tokens", "session_reasoning_tokens", "session_api_calls",
+            "session_estimated_cost_usd", "session_cost_status", "session_cost_source",
+            "_user_turn_count", "_is_user_initiated_turn", "_last_flushed_db_idx",
+        )
+    }
+
+    def always_failing_reset(**_kwargs):
+        for name in source_runtime:
+            setattr(obj.agent, name, 0)
+        for name in engine_state:
+            setattr(engine, name, 0)
+        raise RuntimeError("engine cannot bind either session")
+
+    obj.agent.reset_session_state = always_failing_reset
+    obj._handle_handoff_session_command()
+
+    assert obj.session_id == "source-1"
+    assert obj.agent.session_id == "source-1"
+    assert obj.conversation_history == source_history
+    assert obj.agent._todo_store is source_todo
+    assert obj.agent._cached_system_prompt == source_prompt
+    assert {name: getattr(obj.agent, name) for name in source_runtime} == source_runtime
+    assert engine.__dict__ == engine_state
+    assert process_ids[-1:] == ["source-1"]
+    assert log_ids[-1:] == ["source-1"]
+    assert obj._session_db.get_session("source-1")["ended_at"] is None
+    assert "rollback failed" in capsys.readouterr().out
+
