+def list_verification_evidence(
+    *, session_id: str | None, cwd: str | Path | None, limit: int = 64,
+) -> list[dict[str, Any]]:
+    """Return bounded recorded command evidence for exactly one session/root."""
+    status = verification_status(session_id=session_id, cwd=cwd)
+    root, sid = status.get("root"), status.get("session_id")
+    bounded = max(0, min(int(limit), 64))
+    if not root or not sid or not bounded:
+        return []
+    with _DB_LOCK:
+        with _connect() as conn:
+            rows = conn.execute(
+                """SELECT command, exit_code, created_at FROM verification_events
+                   WHERE session_id = ? AND root = ? ORDER BY id DESC LIMIT ?""",
+                (sid, root, bounded),
+            ).fetchall()
+    return [{"command": str(row["command"])[:4096],
+             "exit_status": int(row["exit_code"]),
+             "timestamp": str(row["created_at"])[:128]}
+            for row in reversed(rows)]
